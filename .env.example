# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional server-side Admin bootstrap credentials (if unset, first-run Admin setup form in UI creates the Admin account)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# MongoDB Connection (Optional in preview; falls back to SQLite if unset)
MONGODB_URI=
MONGODB_DB_NAME=moc_men_craft

# Cloudinary Image Upload & Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
